# API origin, without /v1. Use the API port (8080), not the console port (3000).
VOICE_CLOUD_URL=http://localhost:8080
VOICE_CLOUD_API_KEY=vc_replace_with_your_router_key

# Replace these example IDs with policies for the matching task.
# deployment:<id> also works, but bypasses policy fallback.
LLM_MODEL=policy:1
STT_MODEL=policy:2
TTS_MODEL=policy:3

# Must be supported by every deployment in your TTS policy.
VOICE=alloy
# Language supplied to transcription and used by the router to filter targets.
AUDIO_LANGUAGE=en
